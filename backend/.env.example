# Local development only. Generate JWT_SECRET privately before running.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=repforge_local
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
EMERGENT_LLM_KEY=
ELEVENLABS_API_KEY=
TRUSTED_PROXY_CIDRS=
DAILY_LLM_REQUEST_LIMIT=1200
DAILY_TTS_CHARACTER_LIMIT=150000

# Public contact information (only publish verified addresses).
PUBLIC_OPERATOR_NAME=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_PRIVACY_EMAIL=
# Email recovery is disabled until all sender settings are configured.
PUBLIC_APP_URL=https://www.therepforge.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
